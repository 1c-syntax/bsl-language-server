#Область ПрограммныйИнтерфейс

// Рассчитывает сумму документа с учётом скидки.
//
// Параметры:
//  Товары - ТаблицаЗначений - строки товаров документа
//  ПроцентСкидки - Число - процент скидки
//
// Возвращаемое значение:
//  Число - итоговая сумма
//
Функция СуммаСоСкидкой(Товары, Знач ПроцентСкидки = 0) Экспорт

	Сумма = 0;
	Для Каждого Строка Из Товары Цикл
		Сумма = Сумма + Строка.Количество * Строка.Цена;
	КонецЦикла;

	Возврат Окр(Сумма * (100 - ПроцентСкидки) / 100, 2);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоУмолчанию(Объект)

	Объект.Дата = ТекущаяДатаСеанса();
	Объект.Комментарий = СтрШаблон(НСтр("ru = 'Создан %1'"), Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));

	Структура = Новый Структура("Ключ, Значение", "Код", '20240101');
	Если Структура.Свойство("Ключ") И Не ПустаяСтрока(Структура.Ключ) Тогда
		Сообщить("Ключ: " + Структура.Ключ);
	ИначеЕсли Объект.Дата < '20240101' Тогда
		ВызватьИсключение "Неверная дата";
	КонецЕсли;

	#Если Сервер Тогда
	ЗаписьЖурналаРегистрации("Заполнение", УровеньЖурналаРегистрации.Информация);
	#КонецЕсли

КонецПроцедуры

Асинх Процедура ЗадатьВопрос()

	Ответ = Ждать ВопросАсинх("Продолжить?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоУмолчанию(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
