#Использовать logos

Перем Имя Экспорт;
Перем Лог;

// Конструктор класса.
//
// Параметры:
//   ИмяОбъекта - Строка - имя объекта
//
Процедура ПриСозданииОбъекта(ИмяОбъекта)
	Имя = ИмяОбъекта;
	Лог = Логирование.ПолучитьЛог("oscript.app.example");
КонецПроцедуры

Функция Приветствие() Экспорт
	Части = Новый Массив;
	Части.Добавить("Привет,");
	Части.Добавить(Имя);
	Лог.Информация("Сформировано приветствие для %1", Имя);
	Возврат СтрСоединить(Части, " ");
КонецФункции
