#Использовать helpers-lib

// Формирует заголовок отчёта.
//
// Параметры:
//   Название - Строка - название отчёта
//
// Возвращаемое значение:
//   Строка - заголовок
//
Функция Заголовок(Знач Название) Экспорт
	Рамка = СтроковыеУтилиты.Повторить("=", 3);
	Построитель = Новый ПостроительСтроки(" ");
	Построитель.Добавить(Рамка);
	Построитель.Добавить(СтроковыеУтилиты.ВВерхнийРегистр(Название));
	Построитель.Добавить(Рамка);
	Возврат Построитель.Результат();
КонецФункции
