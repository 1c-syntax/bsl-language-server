//
Процедура ПередДобавлением(Команды) Экспорт
	
КонецПроцедуры

// Новые данные добавления.
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Неопределено
//                 - см. Переопределяемый.НовыйРезультат
//
Функция НовыеДанные() Экспорт
	Данные = Новый Структура;
	Данные.Вставить("Результат", Неопределено);
	Возврат Данные;
КонецФункции
