Перем Браузер;
Перем Результат;

&НаКлиенте
Процедура ПроставитьМетку() Экспорт

	Браузер.форма.метка.значение = Метка;

КонецПроцедуры

&НаКлиенте
Процедура Отправить(Токен, Данные, Ид, ИдРоуминга) Экспорт

	Если ПустаяСтрока(Ид) Тогда
		Результат = Сервис.Создать(Токен, Данные);
	Иначе
		Результат = Сервис.Обновить(Токен, Данные, Ид);
		Если ПустаяСтрока(ИдРоуминга) Тогда
			ИдРоуминга = Результат.Получить("Ид");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
