Перем Состав; // ТаблицаЗначений

Функция СоставЧерезВызов() Экспорт
	Возврат ЛокальныйСостав();
КонецФункции

Функция ЛокальныйСостав()
	Возврат Состав;
КонецФункции

Процедура Инициализировать() Экспорт
	Состав = Поставщик.НовыйСостав();
	Состав.Колонки.Добавить("ПолноеИмя");
КонецПроцедуры

Функция ВесьСостав() Экспорт
	Возврат Состав;
КонецФункции

Функция КопияСостава() Экспорт
	Возврат Состав.Скопировать();
КонецФункции
