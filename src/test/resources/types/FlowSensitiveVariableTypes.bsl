Процедура ПереходПоМетке(Флаг)

	Значение = 1;
	Если Флаг Тогда
		Перейти ~Метка;
	КонецЕсли;
	Значение = "текст";

	~Метка:
	ПослеМетки = Значение;

КонецПроцедуры

Процедура ОбращениеВУсловии(Флаг)

	Значение = 1;
	Значение = "строка";
	Если СтрДлина(Значение) > 0 Тогда
		Сообщить(Флаг);
	КонецЕсли;

	Пока СтрДлина(Значение) > 100 Цикл
		Прервать;
	КонецЦикла;

КонецПроцедуры

