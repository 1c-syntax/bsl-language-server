// Параметры:
//  Значение - Строка, Число - проверяемое значение
Процедура СужениеПоПроверкеТипа(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ВнутриПроверки = Значение;
	Иначе
		ВВеткеИначе = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Число - проверяемое значение
Процедура РесиверПослеПроверкиТипа(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ДлинаЗначения = Значение.Длина();
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Число - проверяемое значение
//  Флаг - Булево - дополнительное условие
Процедура КонъюнкцияСужает(Значение, Флаг)

	Если Флаг И ТипЗнч(Значение) = Тип("Строка") Тогда
		ВнутриКонъюнкции = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Число - проверяемое значение
//  Флаг - Булево - дополнительное условие
Процедура ДизъюнкцияНеСужает(Значение, Флаг)

	Если ТипЗнч(Значение) = Тип("Строка") ИЛИ Флаг Тогда
		ВнутриДизъюнкции = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Флаг - Булево - дополнительное условие
Процедура СужениеПоНеопределено(Флаг)

	Значение = Неопределено;
	Если Флаг Тогда
		Значение = "текст";
	КонецЕсли;

	Если Значение <> Неопределено Тогда
		ВнутриПроверкиНаНеопределено = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Флаг - Булево - дополнительное условие
Процедура ОхранноеПредложение(Флаг)

	Значение = Неопределено;
	Если Флаг Тогда
		Значение = "текст";
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПослеОхраны = Значение;

КонецПроцедуры

// Параметры:
//  Список - Массив из Строка, Число - перебираемый список
Процедура СужениеПеременнойЦикла(Список)

	Для Каждого Элемент Из Список Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			ВнутриПроверкиВЦикле = Элемент;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура СужениеВУсловииПока(Значение)

	Пока Значение <> Неопределено Цикл
		ВнутриПока = Значение;
		Значение = Неопределено;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Граница - Число - верхняя граница
Процедура СчётчикЦикла(Граница)

	Для Сч = 1 По Граница Цикл
		ВнутриФор = Сч;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура ОтрицаниеВУсловии(Значение)

	Если Не Значение = Неопределено Тогда
		ВнутриОтрицания = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Число - проверяемое значение
Процедура ОтрицаниеПроверкиТипа(Значение)

	Если Не ТипЗнч(Значение) = Тип("Строка") Тогда
		ВнутриОтрицанияТипа = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура СужениеВнутриКонъюнкции(Значение)

	Если Значение <> Неопределено И СтрДлина(Значение) > 0 Тогда
		ПослеПроверки = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура СужениеНеПереходитЧерезИли(Значение)

	Если Значение <> Неопределено ИЛИ СтрДлина(Значение) > 1 Тогда
		ПослеИли = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура СужениеВнутриДизъюнкции(Значение)

	Если Значение = Неопределено ИЛИ СтрДлина(Значение) = 0 Тогда
		ВетвьЗаполнения = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура ДизъюнкцияСужаетЛожнуюВетку(Значение)

	Если Значение = Неопределено ИЛИ Значение = "" Тогда
		ВетвьПустого = Значение;
	Иначе
		ВетвьНепустого = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
//  Флаг - Булево - дополнительное условие
Процедура СмешаннаяЦепочкаНеСужает(Значение, Флаг)

	Если Значение <> Неопределено И СтрДлина(Значение) > 0 ИЛИ Флаг Тогда
		ПослеСмешанной = Значение;
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Значение - Строка, Неопределено - проверяемое значение
Процедура ПорядокЗвеньевЗначим(Значение)

	Если СтрДлина(Значение) > 0 И Значение <> Неопределено Тогда
		ПослеОбратногоПорядка = Значение;
	КонецЕсли;

КонецПроцедуры
