// Фикстура сверки с методической рекомендацией «Типизация кода», раздел «Как это работает».
// Имя пробы содержит номер пункта рекомендации: «Проба_2_3» это пункт 2.3.

#Область ОтслеживаниеСостоянияТиповПеременных

Процедура ТипПеременнойЗависитОтМестаИспользования()

	МояПеременная = 10;
	Проба_2_1 = МояПеременная;
	Использование(Проба_2_1);

	МояПеременная = Истина;
	Проба_2_2 = МояПеременная;
	Использование(Проба_2_2);

КонецПроцедуры

#КонецОбласти

#Область ОтслеживаниеСостоянияТиповСвойств

Процедура ТипСвойстваЗадаетсяПриИнициализации()

	Параметры = Новый Структура("МоеСвойство");
	Проба_2_3 = Параметры.МоеСвойство;
	Использование(Проба_2_3);

	Параметры.МоеСвойство = 10;
	Проба_2_4 = Параметры.МоеСвойство;
	Использование(Проба_2_4);

	Параметры.Вставить("ДругоеСвойство", Ложь);
	Проба_2_5 = Параметры.ДругоеСвойство;
	Использование(Проба_2_5);

	Параметры.ДругоеСвойство = 1;
	Проба_2_6 = Параметры.ДругоеСвойство;
	Использование(Проба_2_6);

	Если ТипЗнч(Параметры.ДругоеСвойство) = Тип("Число") Тогда
		Проба_2_7 = Параметры.ДругоеСвойство;
		Использование(Проба_2_7);
	КонецЕсли;

КонецПроцедуры

Процедура ПеремБезТипаОстаетсяНеопределенным(ТабличнаяЧасть)

	Перем ТекущаяСсылка;

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		ТекущаяСсылка = СтрокаТЧ.Ссылка;
	КонецЦикла;

	Проба_2_8 = ТекущаяСсылка;
	Использование(Проба_2_8);

КонецПроцедуры

#КонецОбласти

#Область РасширениеТипов

// Параметры:
//  Элемент - СправочникОбъект.Справочник1 -
Процедура ОбъявленныйТипНеПерекрываетРасчетный(Элемент)

	Проба_2_11 = Элемент;
	Использование(Проба_2_11);

КонецПроцедуры

Процедура ВызовСДругимТипом()

	ОбъявленныйТипНеПерекрываетРасчетный(10);

КонецПроцедуры

Функция ФункцияРазличныхТипов(Флаг)

	Если Флаг Тогда
		Возврат Новый Массив;
	Иначе
		Возврат 10;
	КонецЕсли;

КонецФункции

Процедура РасчетТиповВозвратаПоТелуФункции()

	Проба_2_26 = ФункцияРазличныхТипов(Ложь);
	Использование(Проба_2_26);

	Проба_2_27 = ФункцияРазличныхТипов(Ложь); // Булево -
	Использование(Проба_2_27);

КонецПроцедуры

#КонецОбласти

#Область СокращениеТипа

Процедура СужениеПроверкойТипЗнч(МояПеременная)

	Если ТипЗнч(МояПеременная) = Тип("СправочникОбъект.Справочник1") Тогда
		Проба_2_28 = МояПеременная;
		Использование(Проба_2_28);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Док - ДокументОбъект.Документ1 - объявленный тип поверх расчётного
Процедура ОбъявленныйТипПараметраДействуетВнутриМетода(Док)

	Проба_2_29 = Док;
	Использование(Проба_2_29);

КонецПроцедуры

Процедура ВызовСНеобъявленнымТипом()

	ОбъявленныйТипПараметраДействуетВнутриМетода(Справочники.Справочник1.СоздатьЭлемент());

КонецПроцедуры

Процедура РазборВеткамиПоТипЗнч(Док)

	Если ТипЗнч(Док) = Тип("ДокументОбъект.Документ1") Тогда
		Проба_2_32_1 = Док;
		Использование(Проба_2_32_1);
	ИначеЕсли ТипЗнч(Док) = Тип("СправочникОбъект.Справочник1") Тогда
		Проба_2_32_2 = Док;
		Использование(Проба_2_32_2);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Процедура Использование(Значение)

	Возврат;

КонецПроцедуры
