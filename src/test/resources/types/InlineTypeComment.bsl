Процедура Тест()
	Значение = ВызовФункции(); // Число -
	Имя = ВызовФункции(); // Строка
	Перечисление = ВызовФункции(); // Число, Строка -
	X = Значение;
	Y = Имя;
	Z = Перечисление;
