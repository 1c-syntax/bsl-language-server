Процедура СсылкаВСтрокеПрисваивания()
	ПоЛокальнойСсылке = ВызовФункции(); // см. НовыйОбъектДанных
	ПоМежмодульнойСсылке = ВызовФункции(); // см. ОбщегоНазначения.НовыеСвойстваПодписи
	П = ПоЛокальнойСсылке;
	М = ПоМежмодульнойСсылке;
КонецПроцедуры

Процедура ТипЭлементовКоллекцииВСтроке()
	СписокСсылок = Новый Массив; // Массив из Структура -
	Для Каждого ЭлементМассива Из СписокСсылок Цикл
		ЭМ = ЭлементМассива;
	КонецЦикла;

	МоеСоответствие = Новый Соответствие; // Соответствие из Строка -
	Для Каждого ЭлементСоответствия Из МоеСоответствие Цикл
		ЭС = ЭлементСоответствия;
	КонецЦикла;

	Смешанный = Новый Массив; // Массив из Произвольный, Строка -
	Для Каждого ЭлементСмешанного Из Смешанный Цикл
		ЭСм = ЭлементСмешанного;
	КонецЦикла;
КонецПроцедуры

