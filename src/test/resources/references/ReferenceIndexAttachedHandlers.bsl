Процедура Тест()

    // Обработчик ожидания подключается и отключается по имени — обе ссылки ловим
    ПодключитьОбработчикОжидания("ОбработчикОжидания", 60);
    ОтключитьОбработчикОжидания("ОбработчикОжидания");

    // То же по-английски
    AttachIdleHandler("ОбработчикАнглийский", 1, Истина);

    // Действие элемента формы: имя обработчика — второй параметр
    Элементы.Товары.УстановитьДействие("ПриИзменении", "ТоварыПриИзменении");
    Элементы.Цена.SetAction("OnChange", "ЦенаПриИзменении");

    // Обработчик изменения данных: первым параметром путь к данным, обработчик — вторым
    ПодключитьОбработчикИзмененияДанных("Объект.Дата", "ДатаИзменена", Истина);
    ОтключитьОбработчикИзмененияДанных("Объект.Дата", "ДатаИзменена");

    // Имя собрано в переменной — статически неизвестно, ссылку не ловим
    ИмяОбработчика = "ОбработчикИзПеременной";
    ПодключитьОбработчикОжидания(ИмяОбработчика, 60);

    // Первый параметр УстановитьДействие — имя события, а не обработчика
    Элементы.Склад.УстановитьДействие("ОбработчикСобытияПоИмениСобытия", Неопределено);

