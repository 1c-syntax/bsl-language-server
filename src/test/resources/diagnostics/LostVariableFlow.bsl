Процедура Наблюдаемое(Выход)
    ОбщийСчетчик = 1;
    Наблюдатель();
    ОбщийСчетчик = 2;
    Локальная = 1;
    Выполнить("Сообщить(Локальная)");
    Локальная = 2;
    Сообщить(Локальная);
    Икс = 1;
    Сообщить(Вычислить("Икс"));
    Икс = 2;
    Сообщить(Икс);
    Выход = 1;
КонецПроцедуры

Процедура НеизвестныйИсточник()
    Для Каждого БезОбъявления Из БезОбъявления Цикл
        Сообщить(БезОбъявления);
    КонецЦикла;
КонецПроцедуры

Процедура ОбщаяЯчейка(Первый, Второй)
    Первый = 1;
    Копия = Второй;
    Первый = 2;
    Сообщить(Копия);
КонецПроцедуры
