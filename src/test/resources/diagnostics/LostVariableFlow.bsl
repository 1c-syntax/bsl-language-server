Перем ОбщийСчетчик;

Процедура Повтор(Выход, Знач Локальный)
    Х = ВычислитьПервое();
    Х = ВычислитьВторое();
    Сообщить(Х);
    Х = 3;
    Выход = 1;
    Выход = 2;
    Сообщить(Локальный);
    Локальный = 4;
КонецПроцедуры

Процедура Переходы(Таблица)
    СтрокаТаблицы = Таблица.Найти(1);
    Пока СтрокаТаблицы <> Неопределено Цикл
        СтрокаТаблицы[1] = 2;
        СтрокаТаблицы = Таблица.Найти(1);
    КонецЦикла;
    Флаг = Ложь;
    Для Каждого Элемент Из Таблица Цикл
        Если Флаг Тогда
            Сообщить(Элемент);
        КонецЕсли;
        Если Элемент.Готов Тогда
            Флаг = Истина;
            Продолжить;
        КонецЕсли;
        Флаг = Ложь;
    КонецЦикла;
КонецПроцедуры

Процедура Ветви(Условие)
    Результат = 1;
    Если Условие Тогда
        Результат = 2;
    Иначе
        Результат = 3;
    КонецЕсли;
    Сообщить(Результат);
    Попытка
        Фаза = 1;
        Операция();
        Фаза = 2;
        Операция();
    Исключение
        Сообщить(Фаза);
    КонецПопытки;
КонецПроцедуры

Процедура Итераторы(Коллекция, Объект)
    Для Каждого кОЛЛекция Из Коллекция Цикл
        Сообщить(Коллекция);
    КонецЦикла;
    ДругоеИмя = Коллекция;
    Для Каждого Коллекция Из ДругоеИмя Цикл
        Сообщить(Коллекция);
    КонецЦикла;
    Для Каждого Коллекция Из Объект.Коллекция Цикл
        Сообщить(Коллекция);
    КонецЦикла;
    Для Сч = 1 По 3 Цикл
        Для Каждого Сч Из Объект Цикл
            Сообщить(Сч);
        КонецЦикла;
    КонецЦикла;
    Для Каждого ОбщийСчетчик Из Объект Цикл
        Сообщить(ОбщийСчетчик);
    КонецЦикла;
    Для ОбщийСчетчик = 1 По 3 Цикл
        Сообщить(ОбщийСчетчик);
    КонецЦикла;
КонецПроцедуры

#Область Внешняя
#Область Внутренняя
