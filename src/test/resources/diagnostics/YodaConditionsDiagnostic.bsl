Процедура Тест(Сумма, Ответ, Дата, Флаг, Налог)

    // срабатывает: число слева
    Если 0 = Сумма Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: строка слева
    Если "да" = Ответ Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: дата слева
    Если '20240101' = Дата Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: булев литерал слева
    Если Истина = Флаг Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: знаковый литерал слева
    Если -1 = Сумма Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: остальные операторы сравнения
    Если 0 < Сумма Тогда
        Возврат;
    КонецЕсли;

    Если 0 <= Сумма Тогда
        Возврат;
    КонецЕсли;

    Если 0 > Сумма Тогда
        Возврат;
    КонецЕсли;

    Если 0 >= Сумма Тогда
        Возврат;
    КонецЕсли;

    Если 0 <> Сумма Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: два сравнения в одном условии
    Если (0 = Сумма) И (1 = Сумма) Тогда
        Возврат;
    КонецЕсли;

    // не срабатывает: правильный порядок
    Если Сумма = 0 Тогда
        Возврат;
    КонецЕсли;

    // не срабатывает: оба операнда — литералы
    Если 0 = 1 Тогда
        Возврат;
    КонецЕсли;

    Если Истина = Ложь Тогда
        Возврат;
    КонецЕсли;

    // срабатывает: составной правый операнд
    Если 0 = Сумма + Налог Тогда
        Возврат;
    КонецЕсли;

    Если 0 = -Сумма Тогда
        Возврат;
    КонецЕсли;

    Если 0 = Максимум(Сумма, Налог) Тогда
        Возврат;
    КонецЕсли;

КонецПроцедуры
