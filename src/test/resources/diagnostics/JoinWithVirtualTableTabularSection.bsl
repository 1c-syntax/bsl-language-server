// Табличные части справочника и документа названы как виртуальная таблица регистра «Остатки».
// Виртуальных таблиц у таких объектов нет, соединение с табличной частью замечанием не считается.

Процедура ТабличнаяЧастьСправочникаВСоединении()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Партии.Ссылка КАК Ссылка,
    |    Т.Количество КАК Количество
    |ИЗ
    |    Справочник.Партии КАК Партии
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партии.Остатки КАК Т //<-- не ошибка
    |        ПО Партии.Ссылка = Т.Ссылка";

КонецПроцедуры

Процедура ТабличнаяЧастьДокументаВСоединении()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Инвентаризация.Ссылка КАК Ссылка,
    |    Т.Количество КАК Количество
    |ИЗ
    |    Документ.Инвентаризация КАК Инвентаризация
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Инвентаризация.Остатки КАК Т //<-- не ошибка
    |        ПО Инвентаризация.Ссылка = Т.Ссылка";

КонецПроцедуры

Процедура ТабличнаяЧастьСлеваОтСоединения()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Т.Количество КАК Количество,
    |    Партии.Код КАК Код
    |ИЗ
    |    Справочник.Партии.Остатки КАК Т //<-- не ошибка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партии КАК Партии
    |        ПО Т.Ссылка = Партии.Ссылка";

КонецПроцедуры

Procedure TabularSectionInEnglish()

    Query = New Query;
    Query.Text =
    "SELECT
    |    Batches.Ref AS Ref,
    |    T.Количество AS Количество
    |FROM
    |    Catalog.Партии AS Batches
    |        INNER JOIN Catalog.Партии.Balance AS T //<-- не ошибка
    |        ON Batches.Ref = T.Ref";

EndProcedure

Процедура ВиртуальнаяТаблицаВСоединении()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Партии.Ссылка КАК Ссылка,
    |    Т.КоличествоОстаток КАК Количество
    |ИЗ
    |    Справочник.Партии КАК Партии
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, Партия = &Партия) КАК Т //<-- ошибка
    |        ПО Партии.Ссылка = Т.Партия";

КонецПроцедуры
