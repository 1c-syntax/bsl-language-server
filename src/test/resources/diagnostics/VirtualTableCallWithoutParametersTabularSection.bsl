// Табличные части справочника и документа названы как виртуальные таблицы регистров:
// Остатки, Обороты, ОстаткиИОбороты, СрезПоследних. Виртуальных таблиц у таких объектов нет.

Функция ТабличнаяЧастьСправочникаОстатки()

    Возврат
    "ВЫБРАТЬ
    |    Т.Склад КАК Склад,
    |    Т.Количество КАК Количество
    |ИЗ
    |    Справочник.Партии.Остатки КАК Т"; //<-- не ошибка

КонецФункции

Функция ТабличнаяЧастьСправочникаВСоединении()

    Возврат
    "ВЫБРАТЬ
    |    Партии.Ссылка КАК Ссылка,
    |    Т.Количество КАК Количество
    |ИЗ
    |    Справочник.Партии КАК Партии
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партии.Остатки КАК Т //<-- не ошибка
    |        ПО Партии.Ссылка = Т.Ссылка";

КонецФункции

