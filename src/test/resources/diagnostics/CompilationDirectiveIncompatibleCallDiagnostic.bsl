Процедура Клиентская()
КонецПроцедуры

&НаКлиенте
Функция ФункцияКлиента()
    Возврат Истина;
КонецФункции

&НаСервере
Процедура Серверная(Параметр = Неопределено)
КонецПроцедуры

Процедура БезДирективы()
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВнеконтекстнаяСерверная()
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВнеконтекстнаяКлиентСерверная()
КонецПроцедуры

&НаКлиентеНаСервере
Процедура НедопустимаяВФорме()
    Клиентская(); // не отмечается: метод с этой директивой в форме не компилируется
КонецПроцедуры

&НаКлиенте
Процедура ИзКлиентской()
    Клиентская();
    Серверная();
    БезДирективы();
    ВнеконтекстнаяСерверная();
    ВнеконтекстнаяКлиентСерверная();
КонецПроцедуры

&НаСервере
Процедура ИзСерверной()
    Клиентская(); // ошибка
    Серверная();
    БезДирективы();
    ВнеконтекстнаяСерверная();
    ВнеконтекстнаяКлиентСерверная();
    НедопустимаяВФорме(); // не отмечается: директиву отмечает CompilationDirectiveNotAllowed
    Если ФункцияКлиента() Тогда // ошибка
    КонецЕсли;
    Серверная(ФункцияКлиента()); // ошибка во вложенном вызове
КонецПроцедуры

Процедура ИзБезДирективы()
    Клиентская(); // ошибка
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзВнеконтекстнойСерверной()
    Клиентская(); // ошибка
    Серверная(); // ошибка
    БезДирективы(); // ошибка
    ВнеконтекстнаяСерверная();
    ВнеконтекстнаяКлиентСерверная();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзВнеконтекстнойКлиентСерверной()
    Клиентская(); // ошибка
    Серверная(); // ошибка
    ВнеконтекстнаяСерверная();
    ВнеконтекстнаяКлиентСерверная();
    #Если Клиент Тогда
    Клиентская(); // ошибка: внеконтекстный метод не видит клиентских методов и на клиенте
    #КонецЕсли
    #Если ВнешнееСоединение Тогда
    Клиентская(); // не отмечается: ветка не компилируется в модуле формы
    #КонецЕсли
КонецПроцедуры

&НаСервере
Процедура ПрепроцессорВСерверной()
    #Если Клиент Тогда
    Клиентская(); // не отмечается: ветка не компилируется на сервере
    #Иначе
    Клиентская(); // ошибка
    #КонецЕсли
    #Если НЕ ТонкийКлиент И НЕ ВебКлиент Тогда
    Клиентская(); // ошибка
    #КонецЕсли
    #Если (Сервер ИЛИ ВнешнееСоединение) И НЕ Клиент Тогда
    Клиентская(); // ошибка
    #КонецЕсли
    #Если ВебКлиент Тогда
    #ИначеЕсли Сервер Тогда
    Клиентская(); // ошибка
    #КонецЕсли
    #Если Сервер И Клиент Тогда
    Клиентская(); // не отмечается: условие ложно везде
    #КонецЕсли
    #Если Сервер Тогда
    #ИначеЕсли НЕ Клиент Тогда
    Клиентская(); // не отмечается: сервер забрала первая ветка
    #КонецЕсли
    #Если Linux Тогда
    Клиентская(); // не отмечается: условие зависит от операционной системы
    #КонецЕсли
КонецПроцедуры

#Если Сервер Тогда
&НаСервере
Процедура ВнутриПрепроцессора()
    Клиентская(); // ошибка
КонецПроцедуры
#КонецЕсли

#Если Клиент Тогда
&НаСервере
Процедура ВнутриКлиентскогоПрепроцессора()
    Клиентская(); // не отмечается: метод не компилируется на сервере
КонецПроцедуры
#КонецЕсли

&НаСервере
Процедура ЧерезОбъект()
    ЭтотОбъект.Клиентская(); // не отмечается: вызов через объект
    НеизвестныйМетод(); // не отмечается: метода нет в модуле
КонецПроцедуры

&AtServerNoContext
Procedure FromServerNoContext()
    Серверная(); // ошибка
