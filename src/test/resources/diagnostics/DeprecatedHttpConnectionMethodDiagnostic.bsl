Процедура ОтправитьДанные()

    Соединение = Новый HTTPСоединение("example.com");

    // deprecated — синхронные методы HTTPСоединения
    Соединение.Получить(Запрос, Ответ);     // <-- deprecated
    Соединение.Записать(Данные);             // <-- deprecated
    Соединение.Удалить(Запрос);              // <-- deprecated
    Соединение.ВызватьHTTPМетод("GET", З);  // <-- deprecated

    // не deprecated — асинхронные аналоги
    Соединение.ПолучитьАсинх(Запрос, Ответ);
    Соединение.ЗаписатьАсинх(Данные);

КонецПроцедуры

