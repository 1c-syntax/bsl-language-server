Процедура Тест(Параметр)
    Массив = Новый Массив;
    Массив.Добвить(1);
    Массив.Добавить(1);
    НесуществующийГлобальныйМетод();
    Сообщить("ок");

    // Литеральные ключи Структуры: инференс присоединяет их к ресиверу как
    // local-fields, диагностика должна молчать (тот же источник, что у dot-completion).
    Стр = Новый Структура("ИмяОбъекта, СтароеИмяОбъекта, Успешно");
    Стр.ИмяОбъекта = "X";
    Стр.СтароеИмяОбъекта = "Y";
    Стр.Успешно = Ложь;

    // Method-call варианты для прохода matchMembers / inferArgTypes в DereferenceMemberMatcher:
    // — пустые скобки (n==0 после trim),
    // — trailing skipped argument (n уменьшается в while-loop),
    // — middle skipped argument (SkippedCallArgumentNode внутри цикла),
    // — dereference внутри аргумента (рекурсия findDereferenceForTerminal по MethodCallNode).
    Массив.ВГраница();
    Массив.Найти("a", , );
    Массив.Найти("a", , Истина);
    Сообщить(Массив.Количество());

    // Негатив (регресс ложных срабатываний): у ресивера без выводимого типа
    // (нетипизированный параметр) обращение к члену внутри сравнения. Раньше тип
    // ресивера ошибочно добирался типом ОХВАТЫВАЮЩЕГО выражения (Булево у сравнения),
    // и член проверялся у Булево — ложное срабатывание. Теперь ресивер не выводится,
    // диагностика молчит.
    Если Параметр.НекийМетод() = Истина Тогда
        Сообщить("");
    КонецЕсли;
    Если Параметр.НекоеСвойство > 0 Тогда
        Сообщить("");
    КонецЕсли;

    // Позитив в том же контексте сравнения: у КОНКРЕТНОГО ресивера (Массив)
    // несуществующий член. Сравнение не должно прятать реальный unknown-член.
    Если Массив.НетТакогоМетода() > 0 Тогда
        Сообщить("");
    КонецЕсли;

    // Негатив: обращение к члену под унарным отрицанием / унарным минусом и в
    // ветках тернарника. Корень дерева выражения здесь не бинарная операция, и
    // поиск dereference обязан спуститься под неё — иначе член не находится, а
    // тип ресивера добирается запасным путём (по завершающему идентификатору),
    // и существующий член объявляется неизвестным.
    Если НЕ Стр.Свойство("Успешно") Тогда
        Сообщить("");
    КонецЕсли;
    Если -Массив.Количество() < 0 Тогда
        Сообщить("");
    КонецЕсли;
    Сообщить(?(Истина, Массив.ВГраница(), Стр.Количество()));
КонецПроцедуры
